    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "shopify",
    "ecommerce",
    "ai-shopping",
    "chatgpt-shopping",
    "google-merchant-center",
    "structured-data",
    "json-ld",
    "product-schema",
    "seo",
    "gtin"
