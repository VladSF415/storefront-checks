{
  "name": "storefront-checks",
  "version": "0.1.0",
  "description": "Free, rules-based checks for e-commerce product pages: AI shopping readiness, Google Merchant Center compliance, store SEO audit and Shopify checkout deadlines. Node library, CLI and MCP server. No AI calls, nothing stored.",
